# Copy to .env (git ignores it) and fill in. Only secrets belong here.

# The key named by `api_key_env` in vde.yaml.
ANTHROPIC_API_KEY=

# Image to run; `docker compose up --build` builds this checkout instead.
VDE_IMAGE_TAG=latest

# Development placeholders for the database and the object store. Change them, or keep the
# ports unpublished (as in docker-compose.yaml) so only the compose network reaches them.
VDE_DB_PASSWORD=vde-dev-only
VDE_S3_ACCESS_KEY=vde-dev-only
VDE_S3_SECRET_KEY=vde-dev-only-secret
