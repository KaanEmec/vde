# Copy to .env (git ignores it) and fill in. Only secrets belong here.

# The key named by `api_key_env` in vde.yaml. Use a paid-tier key for confidential documents.
ANTHROPIC_API_KEY=

# Image to run. `latest` is the newest stable release; pin a version such as 0.2.0 for
# anything that matters. Use `docker compose up --build` to build from this checkout instead.
VDE_IMAGE_TAG=latest

# The bearer token for /metrics, used by the `prometheus` profile and by curl. Takes effect
# only with `metrics.token_env: VDE_METRICS_TOKEN` in vde.yaml and the VDE_METRICS_TOKEN
# line of the vde service in docker-compose.yaml, both commented out by default. Development
# placeholder; generate your own with `openssl rand -hex 24`.
VDE_METRICS_TOKEN=dev-metrics-token-change-me

# Only for the commented caddy service: the public host name Caddy gets a certificate for.
# VDE_PUBLIC_HOST=extract.example.com
