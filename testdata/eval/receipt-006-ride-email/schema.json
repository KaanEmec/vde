{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Receipt",
  "description": "A purchase receipt: who sold what, when, for how much and how it was paid.",
  "type": "object",
  "additionalProperties": false,
  "required": ["merchant", "receipt_number", "date", "time", "currency", "items", "subtotal", "tax", "tip", "total", "payment_method"],
  "properties": {
    "merchant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "address"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "description": "The business that issued the receipt, as printed."},
        "address": {"type": ["string", "null"], "description": "The business address as printed, on one line, comma separated."}
      }
    },
    "receipt_number": {"type": ["string", "null"], "description": "The receipt, ticket, check or bon number as printed, without its label."},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "Purchase date, YYYY-MM-DD."},
    "time": {"type": ["string", "null"], "pattern": "^[0-9]{2}:[0-9]{2}$", "description": "Purchase time, HH:MM, 24-hour clock."},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$", "description": "ISO 4217 code."},
    "items": {
      "type": "array",
      "description": "One entry per purchased line, in printed order.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "quantity", "unit_price", "amount"],
        "properties": {
          "description": {"type": "string", "minLength": 1},
          "quantity": {"type": "number", "description": "The printed count or weight, 1 when none is printed."},
          "unit_price": {"type": ["number", "null"], "description": "The printed unit price, null when none is printed."},
          "amount": {"type": "number", "description": "The line total as printed."}
        }
      }
    },
    "subtotal": {"type": ["number", "null"]},
    "tax": {"type": ["number", "null"], "description": "The total tax as printed, included or added."},
    "tip": {"type": ["number", "null"]},
    "total": {"type": "number", "description": "The amount charged."},
    "payment_method": {"enum": ["cash", "card", "mobile", "voucher", "other", null]}
  }
}
