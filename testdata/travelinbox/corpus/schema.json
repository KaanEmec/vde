{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://travelinbox.app/schemas/extraction/v1",
  "title": "TravelInbox extraction result",
  "description": "What the extraction service returns for one document. Unknown values are null or omitted, never guessed. Local times are wall-clock times in the zone of the place they belong to.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reservations"],
  "properties": {
    "schema_version": { "const": 1 },
    "reservations": {
      "type": "array",
      "items": { "$ref": "#/$defs/reservation" }
    },
    "trip_hint": {
      "description": "Where and when the trip this document belongs to takes place, as far as the document says. null when the document has no reservation.",
      "x-vde-grounding": "derived",
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "destination": { "description": "English name of the main city: where the outbound transport arrives; without transport, the city of the stay, meal, event or activity; for a car rental, the pickup city. null when the reservations belong to unrelated trips.", "$ref": "#/$defs/text" },
        "country": { "$ref": "#/$defs/country" },
        "starts_on": { "description": "Earliest date of any reservation in the document.", "$ref": "#/$defs/date" },
        "ends_on": { "description": "Latest start or end date of any reservation in the document.", "$ref": "#/$defs/date" }
      }
    },
    "notes": {
      "description": "Anything the extractor could not fit into the schema or found ambiguous: conflicts, inferred years, changes, references not used. Short English sentences; null when there is nothing to say.",
      "x-vde-grounding": "skip",
      "$ref": "#/$defs/text"
    }
  },
  "$defs": {
    "text": { "type": ["string", "null"], "minLength": 1 },
    "country": {
      "description": "ISO 3166-1 alpha-2.",
      "x-vde-grounding": "derived",
      "type": ["string", "null"],
      "pattern": "^[A-Z]{2}$"
    },
    "iata": { "x-vde-grounding": "derived", "type": ["string", "null"], "pattern": "^[A-Z]{3}$" },
    "date": {
      "description": "Calendar date, YYYY-MM-DD.",
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "local_datetime": {
      "description": "RFC 3339 date-time without offset, YYYY-MM-DDTHH:MM:SS, in the zone of the place. A bare date when the document gives no time.",
      "x-vde-grounding": "critical",
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}:[0-9]{2})?$"
    },
    "local_time": {
      "description": "Wall-clock time, HH:MM.",
      "x-vde-grounding": "critical",
      "type": ["string", "null"],
      "pattern": "^[0-9]{2}:[0-9]{2}$"
    },
    "count": { "x-vde-grounding": "check", "type": ["integer", "null"], "minimum": 1 },
    "place": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "name": { "x-vde-grounding": "check", "$ref": "#/$defs/text" },
        "address": { "x-vde-grounding": "check", "$ref": "#/$defs/text" },
        "iata": { "$ref": "#/$defs/iata" },
        "city": { "x-vde-grounding": "derived", "$ref": "#/$defs/text" },
        "country": { "$ref": "#/$defs/country" }
      }
    },
    "traveller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "description": "Given name then family name, titles dropped, all-caps words capitalised.", "x-vde-grounding": "check", "type": "string", "minLength": 1 },
        "type": { "description": "Only when the document states it for this person; a party count such as 2 adults does not type a named traveller. Otherwise null.", "enum": ["adult", "child", "infant", null] },
        "booking_ref": {
          "description": "This traveller's own reference when the booking prints one per passenger; the reservation's booking_ref is the shared one. Verbatim as printed.",
          "x-vde-grounding": "critical",
          "$ref": "#/$defs/text"
        },
        "ticket_number": {
          "description": "This traveller's own ticket number when the booking prints one per passenger; the reservation's booking_ref is the shared one. Verbatim as printed.",
          "x-vde-grounding": "critical",
          "$ref": "#/$defs/text"
        }
      }
    },
    "price": {
      "description": "Total price as printed. amount is a decimal string to avoid floating point: digits and a dot, no thousands separators, the decimals printed.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": { "x-vde-grounding": "check", "type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,3})?$" },
        "currency": { "description": "ISO 4217.", "x-vde-grounding": "derived", "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    },
    "confidence": {
      "description": "Extractor confidence per reservation field, 0 to 1. Required for every field that is present and not null. An object field gets one number, as low as its weakest part.",
      "x-vde-grounding": "skip",
      "type": "object",
      "required": ["kind", "title"],
      "propertyNames": {
        "enum": [
          "kind", "title", "provider", "booking_ref", "status",
          "starts_at_local", "ends_at_local", "start_place", "end_place",
          "travellers", "price", "cancellation", "details"
        ]
      },
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "reservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "title", "confidence"],
      "properties": {
        "kind": {
          "enum": [
            "flight", "lodging", "transfer", "car_rental", "rail", "bus",
            "ferry", "activity", "dining", "event", "insurance", "other"
          ]
        },
        "title": {
          "description": "Short English label, the one composed field. Transport: '<from city> to <to city>', plus ' via <city>' for connections. Lodging: the property name. Car rental: 'Car rental in <pickup city>'. Dining: 'Dinner at <restaurant>' (or Breakfast, Lunch) when the document or the booked time makes the meal plain, else 'Table at <restaurant>'. Others: their name as printed.",
          "x-vde-grounding": "skip", "type": "string", "minLength": 1
        },
        "provider": { "description": "The company booking_ref is quoted to: the operator (airline, hotel, rental company) when its reference is printed, else the booking platform.", "x-vde-grounding": "check", "$ref": "#/$defs/text" },
        "booking_ref": { "description": "Verbatim as printed. The operator's reference when both an operator and a platform reference are printed; the other goes in notes.", "x-vde-grounding": "critical", "$ref": "#/$defs/text" },
        "status": { "enum": ["confirmed", "cancelled", "pending", null] },
        "starts_at_local": { "description": "Flight: first departure. Lodging: check-in date with the start of the check-in window. Car rental: pickup.", "$ref": "#/$defs/local_datetime" },
        "ends_at_local": { "description": "Flight: last arrival. Lodging: check-out date and time. Car rental: drop-off. Transfer, dining, event, activity: only when printed.", "$ref": "#/$defs/local_datetime" },
        "start_place": { "description": "Departure airport, station or port; the property, restaurant or venue; the pickup location.", "$ref": "#/$defs/place" },
        "end_place": { "description": "Arrival airport, station or port, or the drop-off location. null when the reservation ends where it starts.", "$ref": "#/$defs/place" },
        "travellers": {
          "description": "The named people the booking is for, in document order. Never unnamed people.",
          "type": ["array", "null"],
          "items": { "$ref": "#/$defs/traveller" }
        },
        "price": { "description": "Total paid for this reservation, all travellers. null when only a per-night or per-person price is printed, when paid in points, or when one total covers several reservations.", "$ref": "#/$defs/price" },
        "cancellation": { "description": "Cancellation and change terms as written, trimmed to the policy sentences.", "x-vde-grounding": "skip", "$ref": "#/$defs/text" },
        "details": true,
        "confidence": { "$ref": "#/$defs/confidence" }
      },
      "oneOf": [
        { "properties": { "kind": { "const": "flight" }, "details": { "$ref": "#/$defs/flight" } } },
        { "properties": { "kind": { "const": "lodging" }, "details": { "$ref": "#/$defs/lodging" } } },
        { "properties": { "kind": { "const": "car_rental" }, "details": { "$ref": "#/$defs/car_rental" } } },
        { "properties": { "kind": { "const": "transfer" }, "details": { "$ref": "#/$defs/transfer" } } },
        { "properties": { "kind": { "const": "rail" }, "details": { "$ref": "#/$defs/rail" } } },
        { "properties": { "kind": { "const": "dining" }, "details": { "$ref": "#/$defs/dining" } } },
        { "properties": { "kind": { "const": "event" }, "details": { "$ref": "#/$defs/event" } } },
        { "properties": { "kind": { "const": "activity" }, "details": { "$ref": "#/$defs/activity" } } },
        { "properties": { "kind": { "const": "insurance" }, "details": { "$ref": "#/$defs/insurance" } } },
        { "properties": { "kind": { "enum": ["bus", "ferry", "other"] }, "details": { "$ref": "#/$defs/other" } } }
      ],
      "$comment": "allOf: when an optional field is present and not null, confidence must carry it.",
      "allOf": [
        { "if": { "required": ["provider"], "properties": { "provider": { "not": { "type": "null" } } } }, "then": { "properties": { "confidence": { "type": "object", "required": ["provider"] } } } },
        { "if": { "required": ["booking_ref"], "properties": { "booking_ref": { "not": { "type": "null" } } } }, "then": { "properties": { "confidence": { "type": "object", "required": ["booking_ref"] } } } },
        { "if": { "required": ["status"], "properties": { "status": { "not": { "type": "null" } } } }, "then": { "properties": { "confidence": { "type": "object", "required": ["status"] } } } },
        { "if": { "required": ["starts_at_local"], "properties": { "starts_at_local": { "not": { "type": "null" } } } }, "then": { "properties": { "confidence": { "type": "object", "required": ["starts_at_local"] } } } },
        { "if": { "required": ["ends_at_local"], "properties": { "ends_at_local": { "not": { "type": "null" } } } }, "then": { "properties": { "confidence": { "type": "object", "required": ["ends_at_local"] } } } },
        { "if": { "required": ["start_place"], "properties": { "start_place": { "not": { "type": "null" } } } }, "then": { "properties": { "confidence": { "type": "object", "required": ["start_place"] } } } },
        { "if": { "required": ["end_place"], "properties": { "end_place": { "not": { "type": "null" } } } }, "then": { "properties": { "confidence": { "type": "object", "required": ["end_place"] } } } },
        { "if": { "required": ["travellers"], "properties": { "travellers": { "not": { "type": "null" } } } }, "then": { "properties": { "confidence": { "type": "object", "required": ["travellers"] } } } },
        { "if": { "required": ["price"], "properties": { "price": { "not": { "type": "null" } } } }, "then": { "properties": { "confidence": { "type": "object", "required": ["price"] } } } },
        { "if": { "required": ["cancellation"], "properties": { "cancellation": { "not": { "type": "null" } } } }, "then": { "properties": { "confidence": { "type": "object", "required": ["cancellation"] } } } },
        { "if": { "required": ["details"], "properties": { "details": { "not": { "type": "null" } } } }, "then": { "properties": { "confidence": { "type": "object", "required": ["details"] } } } }
      ]
    },
    "flight_leg": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "number": { "x-vde-grounding": "critical", "$ref": "#/$defs/text" },
        "carrier": { "x-vde-grounding": "check", "$ref": "#/$defs/text" },
        "from_iata": { "$ref": "#/$defs/iata" },
        "to_iata": { "$ref": "#/$defs/iata" },
        "departs_at_local": { "$ref": "#/$defs/local_datetime" },
        "arrives_at_local": { "$ref": "#/$defs/local_datetime" },
        "seat": { "description": "Seat designators only, without \"Seat\" or \"Sitz\"; several separated by ', '.", "pattern": "^[0-9]+[A-Z]?(, [0-9]+[A-Z]?)*$", "x-vde-grounding": "check", "$ref": "#/$defs/text" },
        "cabin": { "description": "Cabin class only, without the fare or tariff name when the document prints both.", "x-vde-grounding": "check", "$ref": "#/$defs/text" },
        "terminal": { "description": "Departure terminal: the designator only, without the word Terminal.", "pattern": "^[A-Za-z0-9]{1,5}$", "x-vde-grounding": "check", "$ref": "#/$defs/text" }
      }
    },
    "flight": {
      "description": "Top-level fields describe the journey (first flight number and carrier, overall origin and destination). legs lists each segment in order when there is more than one, and is null for a single flight. With legs, cabin is set only when the same on all legs, and seat and gate stay null.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "number": { "description": "As printed.", "x-vde-grounding": "critical", "$ref": "#/$defs/text" },
        "carrier": { "description": "The airline printed with the flight number.", "x-vde-grounding": "check", "$ref": "#/$defs/text" },
        "from_iata": { "$ref": "#/$defs/iata" },
        "to_iata": { "$ref": "#/$defs/iata" },
        "seat": { "description": "Every traveller's seat as printed, in traveller order, separated by ', '. Seat designators only, without the word Seat.", "pattern": "^[0-9]+[A-Z]?(, [0-9]+[A-Z]?)*$", "x-vde-grounding": "check", "$ref": "#/$defs/text" },
        "cabin": { "description": "Cabin class only, without the fare or tariff name when the document prints both.", "x-vde-grounding": "check", "$ref": "#/$defs/text" },
        "terminal": { "description": "Departure terminal: the designator only, without the word Terminal.", "pattern": "^[A-Za-z0-9]{1,5}$", "x-vde-grounding": "check", "$ref": "#/$defs/text" },
        "gate": { "x-vde-grounding": "check", "$ref": "#/$defs/text" },
        "legs": { "type": ["array", "null"], "items": { "$ref": "#/$defs/flight_leg" } }
      }
    },
    "lodging": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "room": { "x-vde-grounding": "check", "$ref": "#/$defs/text" },
        "guests": { "$ref": "#/$defs/count" },
        "address": { "x-vde-grounding": "check", "$ref": "#/$defs/text" },
        "phone": { "x-vde-grounding": "check", "$ref": "#/$defs/text" },
        "checkin_time": { "description": "Start of the check-in window.", "$ref": "#/$defs/local_time" },
        "checkout_time": { "description": "Latest check-out time.", "$ref": "#/$defs/local_time" }
      }
    },
    "car_rental": {
      "description": "pickup and dropoff are the instructions as written (desk, shuttle); the places themselves are start_place and end_place.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "vehicle": { "x-vde-grounding": "check", "$ref": "#/$defs/text" },
        "pickup": { "x-vde-grounding": "skip", "$ref": "#/$defs/text" },
        "dropoff": { "x-vde-grounding": "skip", "$ref": "#/$defs/text" }
      }
    },
    "transfer": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "vehicle": { "x-vde-grounding": "check", "$ref": "#/$defs/text" },
        "driver_contact": { "x-vde-grounding": "check", "$ref": "#/$defs/text" }
      }
    },
    "rail": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "train": { "x-vde-grounding": "critical", "$ref": "#/$defs/text" },
        "coach": { "description": "Coach number or letter only, without Coach, Wagen or Wg.", "pattern": "^[A-Za-z0-9]{1,4}$", "x-vde-grounding": "check", "$ref": "#/$defs/text" },
        "seat": { "description": "Seat designators only, without \"Seat\" or \"Sitz\"; several separated by ', '.", "pattern": "^[0-9]+[A-Z]?(, [0-9]+[A-Z]?)*$", "x-vde-grounding": "check", "$ref": "#/$defs/text" },
        "platform": { "x-vde-grounding": "check", "$ref": "#/$defs/text" }
      }
    },
    "dining": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "party_size": { "$ref": "#/$defs/count" },
        "phone": { "x-vde-grounding": "check", "$ref": "#/$defs/text" }
      }
    },
    "event": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "venue": { "x-vde-grounding": "check", "$ref": "#/$defs/text" },
        "seat": { "x-vde-grounding": "check", "$ref": "#/$defs/text" }
      }
    },
    "activity": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "meeting_point": { "x-vde-grounding": "skip", "$ref": "#/$defs/text" }
      }
    },
    "insurance": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "policy": { "x-vde-grounding": "critical", "$ref": "#/$defs/text" }
      }
    },
    "other": {
      "description": "Also used for bus and ferry.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {}
    }
  }
}
