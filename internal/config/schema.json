{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kaanemec/vde/internal/config/schema.json",
  "title": "vde configuration",
  "description": "The vde.yaml file of vde 1.x, for editors; vde config check is authoritative. Descriptions are hints; the reference is docs/operator/configuration.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["endpoints", "groups", "roles"],
  "properties": {
    "server": {
      "description": "The HTTP listener.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "listen": {"type": "string", "description": "Listen address, host:port."},
        "tls": {
          "description": "TLS terminated in the binary; set both files or neither.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cert_file": {"type": "string", "description": "TLS certificate file."},
            "key_file": {"type": "string", "description": "TLS private key file."}
          }
        },
        "trusted_proxy": {"type": "boolean", "description": "A reverse proxy terminates TLS; requests must carry X-Forwarded-Proto: https."},
        "insecure_http": {"type": "boolean", "description": "Accept plain HTTP from any peer (development, trusted networks)."},
        "data_dir": {"type": "string", "description": "Directory for the database, blobs and caches."}
      }
    },
    "endpoints": {
      "description": "Provider endpoints by name.",
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/endpoint"}
    },
    "groups": {
      "description": "Ordered failover lists of endpoint-model pairs by name.",
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/group"}
    },
    "roles": {
      "description": "The group serving each role.",
      "type": "object",
      "additionalProperties": false,
      "required": ["extractor", "judge"],
      "properties": {
        "extractor": {
          "description": "The extractor role; its groups must have no classifier endpoint.",
          "type": "object",
          "additionalProperties": false,
          "required": ["group"],
          "properties": {
            "group": {"type": "string", "description": "Group serving the extractor."},
            "escalation": {"$ref": "#/$defs/escalation"}
          }
        },
        "judge": {
          "description": "The judge role; may use the extractor's group.",
          "type": "object",
          "additionalProperties": false,
          "required": ["group"],
          "properties": {
            "group": {"type": "string", "description": "Group serving the judge."},
            "escalation": {"$ref": "#/$defs/escalation"},
            "policy": {"$ref": "#/$defs/judgePolicy", "description": "When the judge is asked: always (default), never or auto."},
            "feedback_fallback": {
              "type": "string",
              "enum": ["", "whole_result", "llm"],
              "description": "Deprecated (removal in 2.0). What a classifier reject carries."
            },
            "feedback_group": {"type": "string", "description": "Deprecated (removal in 2.0). Group asked for feedback under llm."}
          }
        },
        "second_judge": {
          "description": "Deprecated (removal in 2.0). A second judge that must also accept.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "group": {"type": "string", "description": "Group serving the second judge; empty means off."}
          }
        }
      }
    },
    "limits": {
      "description": "Bounds of the extraction loop and the documents accepted.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_attempts": {"type": "integer", "minimum": 1, "description": "Default attempt limit per application."},
        "job_timeout": {"$ref": "#/$defs/duration", "description": "Deadline per job from its creation."},
        "judge_reparse_tries": {"type": "integer", "minimum": 0, "description": "Extra judge calls when its verdict cannot be parsed."},
        "feedback_message_chars": {"type": "integer", "minimum": 0, "description": "Characters kept per feedback message."},
        "document_bytes": {"type": "integer", "exclusiveMinimum": 0, "description": "Largest document in bytes."},
        "page_bytes": {"type": "integer", "exclusiveMinimum": 0, "description": "Largest page image in bytes."},
        "pages": {"type": "integer", "exclusiveMinimum": 0, "maximum": 999, "description": "Most page images per job."},
        "request_bytes": {"type": "integer", "exclusiveMinimum": 0, "description": "Largest whole request body in bytes."},
        "max_queued_jobs": {"type": "integer", "minimum": 0, "description": "Global ceiling on queued jobs; 0 means none."},
        "max_submits_in_flight": {"type": "integer", "minimum": 1, "description": "Submissions one process reads and prepares at a time."}
      }
    },
    "documents": {
      "description": "The representation policy.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "html": {
          "type": "string",
          "enum": ["raw_html", "visible_text"],
          "description": "HTML representation."
        },
        "images": {
          "description": "Image preparation at submit: downscale, EXIF rotation, WebP conversion.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean", "description": "Prepare images once at submit."},
            "max_dimension": {"type": "integer", "minimum": 64, "maximum": 16384, "description": "Longest side in pixels."},
            "convert_to": {"type": "string", "enum": ["image/jpeg", "image/png"], "description": "Type a converted image is encoded as."},
            "quality": {"type": "integer", "minimum": 1, "maximum": 100, "description": "JPEG quality."}
          }
        },
        "pdf": {
          "description": "How a PDF reaches groups that do not read application/pdf natively.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["auto", "native", "text", "pages"],
              "description": "auto (default), native, text or pages."
            },
            "dpi": {"type": "integer", "minimum": 72, "maximum": 300, "description": "Resolution of rendered pages."},
            "max_pages": {"type": "integer", "minimum": 1, "maximum": 200, "description": "Longer PDFs are refused unless read natively."},
            "min_text_chars_per_page": {"type": "integer", "minimum": 0, "description": "Characters every page needs for auto to send text."},
            "workers": {"type": "integer", "minimum": 1, "maximum": 16, "description": "pdfium instances per process."}
          }
        },
        "fetch": {
          "description": "Deprecated, no effect (removal in 2.0).",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean", "description": "Deprecated, no effect (removal in 2.0)."},
            "allowed_hosts": {"type": "array", "items": {"type": "string"}, "description": "Deprecated, no effect (removal in 2.0)."},
            "max_bytes": {"type": "integer", "minimum": 0, "description": "Deprecated, no effect (removal in 2.0)."},
            "timeout": {"$ref": "#/$defs/duration", "description": "Deprecated, no effect (removal in 2.0)."}
          }
        }
      }
    },
    "applications": {
      "description": "Callers with their own limits.",
      "type": "array",
      "items": {"$ref": "#/$defs/application"}
    },
    "auth": {
      "description": "Bounds of the access tokens.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_token_ttl": {"$ref": "#/$defs/duration", "description": "Longest token lifetime."}
      }
    },
    "logging": {
      "description": "Log output.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {"type": "string", "enum": ["debug", "info", "warn", "error"], "description": "Log level."},
        "format": {"type": "string", "enum": ["json", "text"], "description": "Log format."}
      }
    },
    "debug": {
      "description": "Switches for local development only.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "log_content": {"type": "boolean", "description": "Deprecated, no effect (removal in 2.0)."}
      }
    },
    "metrics": {
      "description": "Protection of GET /metrics.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "token_env": {"$ref": "#/$defs/envName", "description": "Environment variable holding the bearer token /metrics requires."},
        "listen": {"type": "string", "description": "A second listener, host:port, serving only /metrics."},
        "go_runtime": {"type": "boolean", "description": "Add the Go runtime and process series."}
      }
    },
    "admin": {
      "description": "The admin API.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "listen": {"type": "string", "description": "Admin listener, host:port; empty disables it."}
      }
    },
    "worker": {
      "description": "The job worker pool.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": {"type": "integer", "minimum": 1, "maximum": 256, "description": "Jobs run at once."},
        "poll_interval": {"$ref": "#/$defs/duration", "description": "Sleep of an idle worker between looks at the queue."},
        "lease": {"$ref": "#/$defs/duration", "description": "Lease on a running job without renewal."}
      }
    },
    "rate": {
      "description": "Process-wide rate limiting choice.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shared": {"type": "boolean", "description": "Count rate limits in the job store across replicas."}
      }
    },
    "retention": {
      "description": "Process-wide retention settings.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sweep_interval": {"$ref": "#/$defs/duration", "description": "Time between expiry sweeps."}
      }
    },
    "audit": {
      "description": "The audit trail.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "log": {"type": "boolean", "description": "Also write each audit event as a log line."},
        "retention": {"$ref": "#/$defs/duration", "description": "How long audit events are kept."}
      }
    },
    "storage": {
      "description": "The job store.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "driver": {"type": "string", "enum": ["sqlite", "postgres"], "description": "sqlite (default) or postgres."},
        "dsn_env": {"$ref": "#/$defs/envName", "description": "Environment variable holding the PostgreSQL DSN."},
        "max_open_conns": {"type": "integer", "minimum": 0, "maximum": 1000, "description": "PostgreSQL pool size."}
      }
    },
    "blobs": {
      "description": "The blob store of documents and page images.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "driver": {"type": "string", "enum": ["fs", "s3"], "description": "fs (default) or s3."},
        "bucket": {"type": "string", "description": "S3 bucket name; required with s3."},
        "endpoint": {"type": "string", "description": "S3 API URL of a non-AWS store; empty means AWS S3."},
        "region": {"type": "string", "description": "The bucket's region; required with s3."},
        "path_style": {"type": "boolean", "description": "Address the bucket in the URL path (MinIO)."},
        "sse": {"type": "string", "enum": ["AES256", ""], "description": "Server-side encryption: AES256 (default) or empty for none."}
      }
    },
    "sync": {
      "description": "Bounds of POST /v1/extract.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_wait": {"$ref": "#/$defs/duration", "description": "Longest wait before answering 202."}
      }
    }
  },
  "$defs": {
    "duration": {
      "description": "A Go duration such as 90s, 3m or 1h30m; a bare number is rejected.",
      "type": "string",
      "pattern": "^(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$"
    },
    "envName": {
      "description": "Name of an environment variable; empty means none.",
      "type": "string",
      "pattern": "^([A-Za-z_][A-Za-z0-9_]*)?$"
    },
    "judgePolicy": {
      "type": "string",
      "enum": ["", "always", "never", "auto"]
    },
    "pdfMode": {
      "type": "string",
      "enum": ["", "auto", "native", "text", "pages"]
    },
    "mediaType": {
      "type": "string",
      "enum": ["application/pdf", "image/jpeg", "image/png", "image/webp", "image/heic", "text/plain", "text/html", "text/markdown"]
    },
    "escalation": {
      "description": "Deprecated (removal in 2.0). Groups serving later attempts.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from_attempt", "group"],
        "properties": {
          "from_attempt": {"type": "integer", "minimum": 2, "description": "First attempt served by group; strictly increasing."},
          "group": {"type": "string", "description": "Group serving the role from that attempt."}
        }
      }
    },
    "endpoint": {
      "description": "One provider endpoint and the models it serves.",
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "models"],
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["anthropic", "openai_compatible", "gemini", "bedrock", "vertex", "classifier", "fake"],
          "description": "Provider adapter; classifier is deprecated (removal in 2.0)."
        },
        "preset": {"type": "string", "enum": ["", "openrouter"], "description": "openrouter, with openai_compatible only."},
        "base_url": {"type": "string", "description": "API base URL."},
        "api_key_env": {"$ref": "#/$defs/envName", "description": "Environment variable holding the key."},
        "region": {"type": "string", "description": "Cloud region; bedrock and vertex only."},
        "project": {"type": "string", "description": "Google Cloud project id; vertex only."},
        "timeout": {"$ref": "#/$defs/duration", "description": "Per-call timeout."},
        "models": {
          "description": "Models by name with their capability declaration.",
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/model"}
        }
      }
    },
    "model": {
      "description": "One endpoint-model pair's capability declaration.",
      "type": "object",
      "additionalProperties": false,
      "required": ["accepts"],
      "properties": {
        "accepts": {
          "description": "Media types the model reads natively.",
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/mediaType"}
        },
        "max_output_tokens": {"type": "integer", "minimum": 0, "description": "Output-token limit per call."},
        "questions": {
          "description": "Deprecated (removal in 2.0). The classifier's fixed questions.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "text", "threshold"],
            "properties": {
              "id": {"type": "string", "description": "Unique question id."},
              "text": {"type": "string", "description": "The question, phrased so that yes passes."},
              "threshold": {"type": "number", "exclusiveMinimum": 0, "maximum": 1, "description": "Probability of yes needed to pass."}
            }
          }
        }
      }
    },
    "group": {
      "description": "An ordered failover list of endpoint-model pairs.",
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoints"],
      "properties": {
        "endpoints": {
          "description": "Pairs in failover order.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["endpoint", "model"],
            "properties": {
              "endpoint": {"type": "string", "description": "Endpoint name."},
              "model": {"type": "string", "description": "Model declared on the endpoint."}
            }
          }
        },
        "failover": {
          "description": "Bounds of one role call across the pairs.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_tries": {"type": "integer", "minimum": 0, "description": "Tries across the list."},
            "max_total_time": {"$ref": "#/$defs/duration", "description": "Time for one role call; below limits.job_timeout."},
            "failover_on_permanent": {"type": "boolean", "description": "Try the next pair after a permanent failure."}
          }
        }
      }
    },
    "application": {
      "description": "One caller with its own limits.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "description": "Unique application id."},
        "name": {"type": "string", "description": "Display name."},
        "max_attempts": {"type": "integer", "minimum": 0, "description": "Attempt limit."},
        "quota": {
          "description": "Submissions per window.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "limit": {"type": "integer", "minimum": 0, "description": "Submissions per window."},
            "window": {
              "type": "string",
              "pattern": "^(P([0-9]+W)?([0-9]+D)?(T([0-9]+H)?([0-9]+M)?([0-9]+S)?)?)?$",
              "description": "ISO 8601 duration in weeks, days, hours, minutes or seconds."
            }
          }
        },
        "rate": {
          "description": "Rate limits.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests_per_minute": {"type": "integer", "minimum": 0, "description": "Requests per minute across /v1."},
            "submits_per_minute": {"type": "integer", "minimum": 0, "description": "Job submissions per minute."},
            "max_in_progress": {"type": "integer", "minimum": 0, "description": "Jobs queued or running at once."}
          }
        },
        "retention": {
          "description": "Retention policy.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "default": {
              "type": "string",
              "pattern": "^(none|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)?$",
              "description": "Retention of retention: default jobs, a positive duration or none."
            },
            "force_none": {"type": "boolean", "description": "Treat every job as retention: none."},
            "delete_blobs_at_terminal": {"type": "boolean", "description": "Delete the document and pages at the terminal state instead of at expiry."}
          }
        },
        "documents": {
          "description": "Per-application representation overrides.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "html": {"type": "string", "enum": ["", "raw_html", "visible_text"], "description": "Overrides documents.html."},
            "pdf": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {"$ref": "#/$defs/pdfMode", "description": "Overrides documents.pdf.mode."}
              }
            }
          }
        },
        "webhook": {
          "description": "Completion webhook; empty url means none.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {"type": "string", "description": "https URL receiving the signed job.finished notice."},
            "secret_env": {"$ref": "#/$defs/envName", "description": "Environment variable holding the signing secret; required with url."},
            "events": {"type": "array", "items": {"type": "string", "enum": ["job.finished"]}, "description": "Events to send; job.finished is the only one."}
          }
        },
        "judge": {
          "description": "The application's judge policy.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "policy": {"$ref": "#/$defs/judgePolicy", "description": "Overrides roles.judge.policy: always, never or auto."},
            "allow_override": {"type": "boolean", "description": "Let a request choose the policy with the judge part."},
            "sample_rate": {"type": "number", "minimum": 0, "maximum": 1, "description": "Under auto, the share of grounded jobs still sent to the judge."}
          }
        }
      }
    }
  }
}
